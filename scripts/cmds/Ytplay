const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");

const ytplay = {
  nix: {
    name: "ytplay",
    aliases: ["yt", "youtube"],
    author: "Aesther",
    version: "1.1",
    cooldowns: 5,
    role: 0,
    description: "🎶 Rechercher et télécharger l'audio d'une vidéo YouTube",
    category: "music",
    guide: "Utilisation : /ytplay <mots-clés>"
  },

  onStart: async function ({ message, args }) {
    const query = args.join(" ").trim();
    if (!query) return message.reply("❌ | Veuillez fournir un mot-clé.\nExemple : /ytplay Naruto");

    const loading = await message.reply("🔎 | Recherche en cours...");

    try {
      const cacheDir = path.join(__dirname, "cache");
      if (!fs.existsSync(cacheDir)) fs.mkdirSync(cacheDir);

      const res = await axios.get("https://api.nekorinn.my.id/downloader/ytplay-savetube", {
        params: { q: query },
        timeout: 20000
      });

      const data = res.data;
      if (!data?.status || !data?.result?.downloadUrl) {
        throw new Error("Aucune vidéo trouvée ou URL manquante");
      }

      const { title = "Inconnu", channel = "Inconnu", duration = "N/A", url = "N/A" } = data.result.metadata;
      const downloadUrl = data.result.downloadUrl;

      const audioPath = path.join(cacheDir, `${Date.now()}_ytplay.mp3`);
      const audioRes = await axios.get(downloadUrl, { responseType: "arraybuffer", timeout: 30000 });
      fs.writeFileSync(audioPath, audioRes.data);

      await message.reply({
        body:
`🎶 𝗬𝗼𝘂𝗧𝘂𝗯𝗲 𝗣𝗹𝗮𝘆𝗲𝗿 🎧
━━━━━━━━━━━━━━━━━━
📺 Titre : ${title}
🕒 Durée : ${duration}
📣 Chaîne : ${channel}
🔗 Lien : ${url}
━━━━━━━━━━━━━━━━━━`,
        attachment: fs.createReadStream(audioPath)
      });

      fs.unlinkSync(audioPath);

    } catch (err) {
      console.error("YTPLAY ERROR:", err.message);
      await message.reply("❌ | Impossible de récupérer ou télécharger l'audio.");
    } finally {
      try { await message.unsend(loading.messageID); } catch {}
    }
  }
};

module.exports = ytplay;
